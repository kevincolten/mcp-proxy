{
  "name": "mcp-proxy",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "5fbee83cd20b4dfb9b624803b03c0a30" }],
  "routes": [{ "pattern": "mcp.austindevs.com", "custom_domain": true }]
  // Per-service upstream OAuth client config (vars / secrets):
  //   SLACK_CLIENT_ID, SLACK_CLIENT_SECRET (required: Slack has no DCR)
  //   SENTRY_CLIENT_ID / SENTRY_CLIENT_SECRET, TRELLO_CLIENT_ID / TRELLO_CLIENT_SECRET (optional: DCR is used otherwise)
  //   <SERVICE>_SCOPES (optional: override the scopes requested upstream)
}
